{
  "bsonType": "object",
  "required": ["articleId", "content"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "系统自动生成"
    },
    "articleId": {
      "bsonType": "string",
      "title": "所属文章 _id",
      "trim": "both"
    },
    "author": {
      "bsonType": "string",
      "title": "评论者",
      "defaultValue": "匿名"
    },
    "email": {
      "bsonType": "string",
      "title": "邮箱（仅管理端可见）"
    },
    "content": {
      "bsonType": "string",
      "title": "评论内容"
    },
    "createTime": {
      "bsonType": "string",
      "title": "发布时间（YYYY-MM-DD）"
    }
  }
}
