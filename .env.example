# ── uniCloud 部署配置（模板）──────────────────────────────────────
# 复制为 .env 后填入自己的值：cp .env.example .env
# .env 已 gitignore，不会入库；这些值原先硬编码在脚本与文档里，现统一由环境变量注入。
# 脚本用 `node --env-file-if-exists=.env` 自动读取（见 package.json 的 verify:unicloud / deploy:unicloud）。

# 服务空间 ID：uniCloud 控制台 → 服务空间 → 空间详情，形如 env-xxxxxxxx
# URL 化域名与静态托管域名都由它拼出
UNICLOUD_SPACE_ID=

# 云商：alipay | aliyun | tencent（决定 URL 化域名后缀；不填默认 alipay）
UNICLOUD_PROVIDER=alipay

# 云函数 URL 化地址（接口 base）。自检脚本用它探测线上接口
#   支付宝云  https://<spaceId>.dev-hz.cloudbasefunction.cn/mz-api
#   阿里云    https://<spaceId>.bspapp.com/mz-api
#   腾讯云    https://<spaceId>.service.tcloudbase.com/mz-api
# ⚠️ 支付宝云要 dev-hz（URL 化），不是 api-hz（云函数调用）——打错会得到网关 50002
UNICLOUD_URL_BASE=

# 前端网页托管域名，形如 https://<spaceId>-static.normal.cloudstatic.cn
# 自检脚本用它校验跨域响应头
UNICLOUD_STATIC_HOST=

# 批量导入令牌，需与云函数环境变量 SEED_TOKEN 一致（仅 POST /api/admin/seed 用）
# 配在 .env 里可避免在命令行/文档里粘贴明文
UNICLOUD_SEED_TOKEN=
