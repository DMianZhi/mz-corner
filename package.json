{
  "name": "mz-corner",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "run-p dev:client dev:server",
    "dev:client": "pnpm --filter @mz-corner/client dev",
    "dev:server": "pnpm --filter @mz-corner/server dev",
    "pack": "run-p pack:frontend pack:server",
    "pack:frontend": "pnpm --filter @mz-corner/client pack:frontend",
    "pack:server": "pnpm --filter @mz-corner/server pack:server",
    "lint": "run-p lint:client lint:server",
    "lint:client": "pnpm --filter @mz-corner/client lint",
    "lint:server": "pnpm --filter @mz-corner/server lint",
    "build": "run-p build:client build:server",
    "build:client": "pnpm --filter @mz-corner/client build",
    "build:server": "pnpm --filter @mz-corner/server build",
    "check:types": "run-p check:types:client check:types:server",
    "check:types:client": "pnpm --filter @mz-corner/client check:types",
    "check:types:server": "pnpm --filter @mz-corner/server check:types",
    "test": "run-p test:client test:server",
    "test:client": "pnpm --filter @mz-corner/client test",
    "test:server": "pnpm --filter @mz-corner/server test",
    "build:unicloud": "node scripts/build-unicloud.mjs",
    "prepare:unicloud": "node scripts/prepare-unicloud-project.mjs",
    "deploy:unicloud": "node scripts/deploy-unicloud.mjs",
    "harness:unicloud": "node scripts/local-unicloud-harness.mjs",
    "export:init-data": "node scripts/export-init-data.mjs",
    "verify:unicloud": "node scripts/verify-unicloud-deploy.mjs"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "cross-env": "^7.0.3",
    "dotenv": "^17.4.2",
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
